---
// src/pages/whatsnew.astro — Phase 04.1 (Plan 04.1-04) informational
// site-page route. Renders /whatsnew/ by extracting verbatim TEXT
// from legacy/whatsnew.html at build time.
//
// Same pipeline as about.astro — see that file's header for the full
// contract. preserveScripts: true (release log fetches archive feeds +
// per-archive manifests via relative URLs — see hotfix 2026-06-02).
// pageType="site-page" forces Pagefind body marker (B-1 fix).

import RootLayout from '../layouts/RootLayout.astro';
import sitePages from '../data/site-pages.json';
import { extractMain, scrubChrome } from '../scripts/extractLegacyBody';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import '../styles/site-pages.css';

const SLUG = 'whatsnew';
const entry = sitePages.find((e) => e.slug === SLUG)!;
const raw = readFileSync(resolve(process.cwd(), entry.legacyPath), 'utf8');
const anchor = extractMain(raw, entry.legacyPath);
const bodyHtml = scrubChrome(anchor, { preserveScripts: entry.preserveScripts });
---
<RootLayout
  archiveSlug="wargov"
  pageType="site-page"
  title={`${entry.title} — realufo.org`}
  description={entry.subtitle}
>
  {/* Hotfix 2026-06-02: legacy script fetches per-archive feeds via
      relative paths (`aaro/feed.atom`). Route move to `/whatsnew/`
      broke relative resolution → empty list. <base href="/"> restores
      legacy resolution. See .planning/debug/site-pages-broken.md. */}
  <base slot="head-extra" href="/" />

  <section class="hero">
    <div class="container">
      <h1 class="hero-title">{entry.title}</h1>
      <p class="hero-sub">{entry.subtitle}</p>
    </div>
  </section>
  <article class="page-body" data-slug={SLUG} data-pagefind-body set:html={bodyHtml}></article>
</RootLayout>
