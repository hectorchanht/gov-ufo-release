---
// Nav.astro — sticky 64px header with seal + brand + hamburger + 4-archive
// cross-nav (CLAUDE.md §4 + §4.1 + D-19).
//
// SCOPE PIVOT (2026-05-28): realufo.org ships ONLY 4 active archives:
// wargov, aaro, nasa, nara. The 11 dormant archives (geipan, uk, brazil,
// chile, argentina, canada, italy, nz, peru, spain, uruguay) remain in
// the repo (code + data + content collections + TONE map preserved) but
// are NOT linked from the user-facing nav. ArchiveSlug type union still
// covers all 15 so re-adding any one slug is a 1-line edit to ARCHIVES +
// BRAND. RootLayout adds data-pagefind-ignore to <main> when archiveSlug
// is not in the active set (see RootLayout.astro ACTIVE_ARCHIVES).
//
// BRAND map is also slimmed to 4 entries. Defensive default still falls
// back to wargov for any dormant archive that briefly renders the Nav
// (e.g. nz/uruguay legacy pages preserved for direct-URL access).
//
// CLAUDE.md §11 don't: NO inline upper-right arrow (U+2197) in header links
// (reserved for footer external sources). Internal archive-to-archive links
// only here. The single-direction right-arrow (U+2192) on "All stories" is
// the internal-flow "more" marker per UI-SPEC §2.1 — a different glyph from
// the forbidden external-link upper-right arrow (U+2197).
//
// Phase 04.1 — STORIES ▾ + ABOUT ▾ dropdowns added (Plan 04.1-05).
// • STORIES panel: 8 featured stories from src/data/stories.json, divider,
//   "All stories →" link.
// • ABOUT panel: 6 fixed site-page entries mirroring src/data/site-pages.json.
// Desktop: pure CSS `:hover` + `:focus-within` reveal (no JS framework).
// Mobile (<720 px): the dropdown trigger becomes a collapsible section header
// inside the open hamburger menu — `<script is:inline>` toggles aria-expanded
// + `.open` on the parent <li>.

import type { ArchiveSlug } from '../layouts/RootLayout.astro';
import stories from '../data/stories.json';

interface Props {
  archiveSlug: ArchiveSlug;
}

const { archiveSlug } = Astro.props;

// Phase 04.1 W-3 gate: featured order must be unique {1..8}. Reading
// src/data/stories.json at build time means any drift (missing featured
// flag, duplicate order, gap in the sequence) fails the build here
// rather than producing a half-rendered nav surface.
const FEATURED_STORIES = stories
  .filter((s) => s.featured === true)
  .sort((a, b) => a.order - b.order);

{
  const orders = FEATURED_STORIES.map((s) => s.order);
  const unique = new Set(orders);
  const ok =
    FEATURED_STORIES.length === 8 &&
    unique.size === 8 &&
    orders[0] === 1 &&
    orders[orders.length - 1] === 8;
  if (!ok) {
    throw new Error(
      `[Nav.astro] Featured-story W-3 gate failed: expected 8 featured stories with unique order 1..8, got ${
        FEATURED_STORIES.length
      } entries with orders ${JSON.stringify(orders)}`,
    );
  }
}

// Fixed list — order = display order. Mirrors src/data/site-pages.json
// (duplication intentional: keeps Nav.astro decoupled from the JSON for
// label-only display tweaks). Footer.astro carries the same shape.
const ABOUT_PAGES = [
  { slug: 'about',     label: 'About' },
  { slug: 'foia',      label: 'FOIA' },
  { slug: 'glossary',  label: 'Glossary' },
  { slug: 'map',       label: 'Map' },
  { slug: 'timeline',  label: 'Timeline' },
  { slug: 'whatsnew',  label: "What's New" },
] as const;

// 4-archive active cross-nav (post-2026-05-28 scope pivot). Each <a>
// emits the slug verbatim via `data-archive=` for consistency with the
// pre-pivot contract; downstream tooling that greps for any of the 4
// active slugs continues to work.
const ARCHIVES = [
  { slug: 'wargov', name: 'WAR.GOV', path: '/' },
  { slug: 'aaro',   name: 'AARO',    path: '/aaro/' },
  { slug: 'nasa',   name: 'NASA',    path: '/nasa/' },
  { slug: 'nara',   name: 'NARA',    path: '/nara/' },
] as const;

// Brand text per ACTIVE archive — short display name only (full name lives
// in page <h1>). Mirrors legacy index.html's "U.S. Department of War" seal.
// Dormant archives (nz, uruguay, etc.) fall through to the wargov default
// via the lookup below. They are not user-navigable from Nav post-pivot,
// but direct-URL access still renders a usable seal.
const BRAND: Partial<Record<ArchiveSlug, { super: string; name: string; sealMark: string }>> = {
  wargov: { super: 'U.S. Department of',               name: 'War',  sealMark: 'DOW'  },
  aaro:   { super: 'All-domain Anomaly Resolution Office',                    name: 'AARO', sealMark: 'AARO' },
  nasa:   { super: 'National Aeronautics & Space',     name: 'NASA', sealMark: 'NASA' },
  nara:   { super: 'National Archives & Records',      name: 'NARA', sealMark: 'NARA' },
};

const brand = BRAND[archiveSlug] ?? BRAND.wargov!;
---

<div class="header-wrap">
  <header>
    <div class="container flex">
      <div class="brand-row">
        <a href={ARCHIVES.find(a => a.slug === archiveSlug)?.path ?? '/'} class="brand">
          <div class="seal" aria-hidden="true">{brand.sealMark}</div>
          <div class="brand-text">
            <span class="super">{brand.super}</span>
            <span class="name">{brand.name}</span>
          </div>
        </a>
        <button
          class="nav-toggle"
          id="nav-toggle"
          aria-label="Toggle navigation"
          aria-controls="primary-nav"
          aria-expanded="false"
          type="button"
        >
          <span></span><span></span><span></span>
        </button>
      </div>
      <nav class="primary" id="primary-nav" aria-label="Main navigation">
        <ul>
          {ARCHIVES.map((a) => (
            <li>
              <a
                href={a.path}
                data-archive={a.slug}
                aria-current={a.slug === archiveSlug ? 'page' : undefined}
                class:list={[a.slug === archiveSlug && 'active']}
              >
                {a.name}
              </a>
            </li>
          ))}
          {/* Phase 04.1 — STORIES ▾ dropdown. 8 featured stories from
              src/data/stories.json + divider + "All stories →". UI-SPEC §2.1.
              Desktop reveal via pure CSS (:hover, :focus-within); mobile
              reveal via the inline <script> below that toggles `.open` on
              this <li> for taps in the hamburger menu. */}
          <li class="nav-dropdown" data-dropdown="stories">
            <button
              class="nav-dropdown-trigger"
              type="button"
              aria-haspopup="menu"
              aria-expanded="false"
              aria-controls="nav-dd-stories-panel"
              id="nav-dd-stories"
            >
              Stories <span aria-hidden="true" class="dd-chev">▾</span>
            </button>
            <ul
              class="nav-dropdown-panel"
              role="menu"
              id="nav-dd-stories-panel"
              aria-labelledby="nav-dd-stories"
            >
              {FEATURED_STORIES.map((s) => (
                <li role="none">
                  <a role="menuitem" href={`/stories/${s.slug}/`}>{s.title}</a>
                </li>
              ))}
              <li class="nav-dropdown-divider" role="separator" aria-hidden="true"></li>
              <li role="none">
                <a role="menuitem" href="/stories/" class="nav-dropdown-all">All stories →</a>
              </li>
            </ul>
          </li>
          {/* Phase 04.1 — ABOUT ▾ dropdown. 6 site-page entries; order = display
              order per UI-SPEC §2.2. Same desktop/mobile reveal pattern as
              STORIES ▾. */}
          <li class="nav-dropdown" data-dropdown="about">
            <button
              class="nav-dropdown-trigger"
              type="button"
              aria-haspopup="menu"
              aria-expanded="false"
              aria-controls="nav-dd-about-panel"
              id="nav-dd-about"
            >
              About <span aria-hidden="true" class="dd-chev">▾</span>
            </button>
            <ul
              class="nav-dropdown-panel"
              role="menu"
              id="nav-dd-about-panel"
              aria-labelledby="nav-dd-about"
            >
              {ABOUT_PAGES.map((p) => (
                <li role="none">
                  <a role="menuitem" href={`/${p.slug}/`}>{p.label}</a>
                </li>
              ))}
            </ul>
          </li>
          {/* Page-level intra-archive anchors (Headlines / Archive / etc.) are
              page-injected via <slot name="nav-extra" /> so this component
              stays archive-agnostic. */}
          <slot name="nav-extra" />
        </ul>
      </nav>
    </div>
  </header>
</div>

{/* Hamburger toggle — defence-in-depth duplicate of invariants.ts (1).
    Idempotent: invariants.ts checks navToggle.dataset.wired before binding.
    This block lets Nav.astro work in component-isolation contexts (story-
    book / component preview) where RootLayout's bottom-of-body script is
    absent. D-21..D-23 — <script is:inline>, no Vite bundling. */}
<script is:inline>
  (function () {
    var navToggle = document.getElementById('nav-toggle');
    var primaryNav = document.getElementById('primary-nav');
    if (!navToggle || !primaryNav) return;
    if (navToggle.dataset.wired) return;
    navToggle.dataset.wired = '1';
    navToggle.addEventListener('click', function () {
      var open = primaryNav.classList.toggle('open');
      navToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    });

    // Mobile-only dropdown toggle. Desktop uses pure CSS (:hover, :focus-
    // within) so we only intercept clicks below the 720 px breakpoint per
    // CLAUDE.md §8 — the same breakpoint that surfaces the hamburger.
    var MOBILE_MQ = '(max-width: 719.98px)';
    function isMobile() {
      return window.matchMedia && window.matchMedia(MOBILE_MQ).matches;
    }
    var triggers = primaryNav.querySelectorAll('.nav-dropdown-trigger');
    for (var i = 0; i < triggers.length; i++) {
      var t = triggers[i];
      if (t.dataset.wired) continue;
      t.dataset.wired = '1';
      t.addEventListener('click', function (ev) {
        if (!isMobile()) return; // desktop: defer to CSS
        ev.preventDefault();
        ev.stopPropagation();
        var li = ev.currentTarget.closest('.nav-dropdown');
        if (!li) return;
        var open = li.classList.toggle('open');
        ev.currentTarget.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
      t.addEventListener('keydown', function (ev) {
        if (ev.key === 'Escape') {
          var li = ev.currentTarget.closest('.nav-dropdown');
          if (li && li.classList.contains('open')) {
            li.classList.remove('open');
            ev.currentTarget.setAttribute('aria-expanded', 'false');
            ev.currentTarget.focus();
          }
        }
      });
    }

    primaryNav.addEventListener('click', function (e) {
      if (e.target && e.target.tagName === 'A') {
        primaryNav.classList.remove('open');
        navToggle.setAttribute('aria-expanded', 'false');
        // Also close any open dropdown panel — the link is about to navigate
        // and a stale `.open` flag would re-show the panel on bfcache restore.
        var openDD = primaryNav.querySelectorAll('.nav-dropdown.open');
        for (var j = 0; j < openDD.length; j++) {
          openDD[j].classList.remove('open');
          var trig = openDD[j].querySelector('.nav-dropdown-trigger');
          if (trig) trig.setAttribute('aria-expanded', 'false');
        }
      }
    });
  })();
</script>

<style>
  /* Component-scoped tweaks layered atop global.css's .header-wrap / .nav-* base.
     Mobile-first: the global stylesheet covers most layout; this block adds
     archive-specific spacing inside the brand row + the row layout. */
  .brand-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
    padding: 8px 0;
    gap: 16px;
  }

  /* CLAUDE.md §4 — sticky 64px header. The .header-wrap base lives in
     global.css; this scoped rule ensures the inner header element fills it. */
  header { width: 100%; }
</style>
