---
// Nav.astro — sticky 64px header with seal + brand + hamburger + 4-archive
// cross-nav (CLAUDE.md §4 + §4.1 + D-19).
//
// SCOPE PIVOT (2026-05-28): realufo.org ships ONLY 4 active archives:
// wargov, aaro, nasa, nara. The 11 dormant archives (geipan, uk, brazil,
// chile, argentina, canada, italy, nz, peru, spain, uruguay) remain in
// the repo (code + data + content collections + TONE map preserved) but
// are NOT linked from the user-facing nav. ArchiveSlug type union still
// covers all 15 so re-adding any one slug is a 1-line edit to ARCHIVES +
// BRAND. RootLayout adds data-pagefind-ignore to <main> when archiveSlug
// is not in the active set (see RootLayout.astro ACTIVE_ARCHIVES).
//
// BRAND map is also slimmed to 4 entries. Defensive default still falls
// back to wargov for any dormant archive that briefly renders the Nav
// (e.g. nz/uruguay legacy pages preserved for direct-URL access).
//
// CLAUDE.md §11 don't: NO inline upper-right arrow (U+2197) in header links
// (reserved for footer external sources). Internal archive-to-archive links
// only here. The single-direction right-arrow (U+2192) on "All stories" is
// the internal-flow "more" marker per UI-SPEC §2.1 — a different glyph from
// the forbidden external-link upper-right arrow (U+2197).
//
// Phase 04.1 — STORIES ▾ + ABOUT ▾ dropdowns added (Plan 04.1-05).
// • STORIES panel: 8 featured stories from src/data/stories.json, divider,
//   "All stories →" link.
// • ABOUT panel: 6 fixed site-page entries mirroring src/data/site-pages.json.
// Desktop: pure CSS `:hover` + `:focus-within` reveal (no JS framework).
// Mobile (<720 px): the dropdown trigger becomes a collapsible section header
// inside the open hamburger menu — an `is:inline` script toggles aria-expanded
// + `.open` on the parent <li>.

import type { ArchiveSlug } from '../layouts/RootLayout.astro';
import stories from '../data/stories.json';

interface Props {
  archiveSlug: ArchiveSlug;
}

const { archiveSlug } = Astro.props;

// Phase 04.1 W-3 gate: featured order must be unique {1..8}. Reading
// src/data/stories.json at build time means any drift (missing featured
// flag, duplicate order, gap in the sequence) fails the build here
// rather than producing a half-rendered nav surface.
const FEATURED_STORIES = stories
  .filter((s) => s.featured === true)
  .sort((a, b) => a.order - b.order);

{
  const orders = FEATURED_STORIES.map((s) => s.order);
  const unique = new Set(orders);
  const ok =
    FEATURED_STORIES.length === 8 &&
    unique.size === 8 &&
    orders[0] === 1 &&
    orders[orders.length - 1] === 8;
  if (!ok) {
    throw new Error(
      `[Nav.astro] Featured-story W-3 gate failed: expected 8 featured stories with unique order 1..8, got ${
        FEATURED_STORIES.length
      } entries with orders ${JSON.stringify(orders)}`,
    );
  }
}

// Fixed list — order = display order. Mirrors src/data/site-pages.json
// (duplication intentional: keeps Nav.astro decoupled from the JSON for
// label-only display tweaks). Footer.astro carries the same shape.
const ABOUT_PAGES = [
  { slug: 'about',     label: 'About' },
  { slug: 'foia',      label: 'FOIA' },
  { slug: 'glossary',  label: 'Glossary' },
  { slug: 'map',       label: 'Map' },
  { slug: 'timeline',  label: 'Timeline' },
  { slug: 'whatsnew',  label: "What's New" },
] as const;

// 4-archive active cross-nav (post-2026-05-28 scope pivot). Each <a>
// emits the slug verbatim via `data-archive=` for consistency with the
// pre-pivot contract; downstream tooling that greps for any of the 4
// active slugs continues to work.
const ARCHIVES = [
  { slug: 'wargov', name: 'WAR.GOV', path: '/' },
  { slug: 'aaro',   name: 'AARO',    path: '/aaro/' },
  { slug: 'nasa',   name: 'NASA',    path: '/nasa/' },
  { slug: 'nara',   name: 'NARA',    path: '/nara/' },
] as const;

// Brand text per ACTIVE archive — short display name only (full name lives
// in page <h1>). Mirrors legacy index.html's "U.S. Department of War" seal.
// Dormant archives (nz, uruguay, etc.) fall through to the wargov default
// via the lookup below. They are not user-navigable from Nav post-pivot,
// but direct-URL access still renders a usable seal.
const BRAND: Partial<Record<ArchiveSlug, { super: string; name: string; sealMark: string }>> = {
  wargov: { super: 'U.S. Department of',               name: 'War',  sealMark: 'DOW'  },
  aaro:   { super: 'All-domain Anomaly Resolution Office',                    name: 'AARO', sealMark: 'AARO' },
  nasa:   { super: 'National Aeronautics & Space',     name: 'NASA', sealMark: 'NASA' },
  nara:   { super: 'National Archives & Records',      name: 'NARA', sealMark: 'NARA' },
};

const brand = BRAND[archiveSlug] ?? BRAND.wargov!;
---

<div class="header-wrap">
  <header>
    <div class="container flex">
      <div class="brand-row">
        <a href={ARCHIVES.find(a => a.slug === archiveSlug)?.path ?? '/'} class="brand">
          <div class="seal" aria-hidden="true">{brand.sealMark}</div>
          <div class="brand-text">
            <span class="super">{brand.super}</span>
            <span class="name">{brand.name}</span>
          </div>
        </a>
        <button
          class="nav-toggle"
          id="nav-toggle"
          aria-label="Toggle navigation"
          aria-controls="primary-nav"
          aria-expanded="false"
          type="button"
        >
          <span></span><span></span><span></span>
        </button>
      </div>
      <nav class="primary" id="primary-nav" aria-label="Main navigation">
        <ul>
          {ARCHIVES.map((a) => (
            <li>
              <a
                href={a.path}
                data-archive={a.slug}
                aria-current={a.slug === archiveSlug ? 'page' : undefined}
                class:list={[a.slug === archiveSlug && 'active']}
              >
                {a.name}
              </a>
            </li>
          ))}
          {/* Phase 04.1 — STORIES ▾ dropdown. 8 featured stories from
              src/data/stories.json + divider + "All stories →". UI-SPEC §2.1.
              Visibility is JS-driven via `aria-expanded` + `hidden`. CSS no
              longer uses `:hover` or `:focus-within` to reveal — those caused
              both panels to render simultaneously when focus moved between
              them (Phase 04.1 hotfix). The inline controller below enforces
              single-open invariant + outside-click close + Esc close. */}
          <li class="nav-dropdown" data-dropdown="stories">
            <button
              class="nav-dropdown-trigger"
              type="button"
              aria-haspopup="menu"
              aria-expanded="false"
              aria-controls="nav-dd-stories-panel"
              id="nav-dd-stories"
            >
              Stories <span aria-hidden="true" class="dd-chev">▾</span>
            </button>
            <ul
              class="nav-dropdown-panel"
              role="menu"
              id="nav-dd-stories-panel"
              aria-labelledby="nav-dd-stories"
              hidden
            >
              {FEATURED_STORIES.map((s) => (
                <li role="none">
                  <a role="menuitem" tabindex="-1" href={`/stories/${s.slug}/`}>{s.title}</a>
                </li>
              ))}
              <li class="nav-dropdown-divider" role="separator" aria-hidden="true"></li>
              <li role="none">
                <a role="menuitem" tabindex="-1" href="/stories/" class="nav-dropdown-all">All stories →</a>
              </li>
            </ul>
          </li>
          {/* Phase 04.1 — ABOUT ▾ dropdown. 6 site-page entries; order = display
              order per UI-SPEC §2.2. Same JS-driven reveal pattern as STORIES ▾. */}
          <li class="nav-dropdown" data-dropdown="about">
            <button
              class="nav-dropdown-trigger"
              type="button"
              aria-haspopup="menu"
              aria-expanded="false"
              aria-controls="nav-dd-about-panel"
              id="nav-dd-about"
            >
              About <span aria-hidden="true" class="dd-chev">▾</span>
            </button>
            <ul
              class="nav-dropdown-panel"
              role="menu"
              id="nav-dd-about-panel"
              aria-labelledby="nav-dd-about"
              hidden
            >
              {ABOUT_PAGES.map((p) => (
                <li role="none">
                  <a role="menuitem" tabindex="-1" href={`/${p.slug}/`}>{p.label}</a>
                </li>
              ))}
            </ul>
          </li>
          {/* Page-level intra-archive anchors (Headlines / Archive / etc.) are
              page-injected via <slot name="nav-extra" /> so this component
              stays archive-agnostic. */}
          <slot name="nav-extra" />
        </ul>
      </nav>
    </div>
  </header>
</div>

{/* Hamburger toggle — defence-in-depth duplicate of invariants.ts (1).
    Idempotent: invariants.ts checks navToggle.dataset.wired before binding.
    This block lets Nav.astro work in component-isolation contexts (story-
    book / component preview) where RootLayout's bottom-of-body script is
    absent. D-21..D-23 — is:inline script, no Vite bundling. */}
<script is:inline>
  /*
   * Nav.astro dropdown controller — Phase 04.1 hotfix (2026-06-02).
   *
   * Replaces the prior CSS `:hover` + `:focus-within` + `.open` reveal model
   * which allowed both STORIES ▾ and ABOUT ▾ to render simultaneously because
   * `:focus-within` stuck after Tab into a panel and never auto-closed when
   * another trigger was hovered/clicked.
   *
   * New invariants:
   *   1. At most ONE dropdown open at any time (single-open).
   *   2. Click trigger toggles. Click outside closes. Esc closes + restores focus.
   *   3. Hover with 120 ms intent-delay opens; immediate close on mouse-leave
   *      with 200 ms grace so cursor can travel from trigger to panel.
   *   4. Tab focus into a dropdown trigger opens it; focus moving outside the
   *      dropdown closes it.
   *   5. Mobile (<720 px) — hamburger drawer mode: dropdowns become inline
   *      collapsibles inside the drawer (no fly-out positioning).
   *
   * Visibility is driven ONLY by `aria-expanded` on the trigger + the `hidden`
   * attribute on the panel. CSS no longer uses `:hover` / `:focus-within` to
   * reveal panels — see global.css `.nav-dropdown-panel` rules.
   */
  (function () {
    var navToggle = document.getElementById('nav-toggle');
    var primaryNav = document.getElementById('primary-nav');
    if (!navToggle || !primaryNav) return;

    // Idempotent — RootLayout.astro may also wire the hamburger from a global
    // invariants script. dataset.wired guards both.
    if (!navToggle.dataset.wired) {
      navToggle.dataset.wired = '1';
      navToggle.addEventListener('click', function () {
        var open = primaryNav.classList.toggle('open');
        navToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        // Hamburger close also closes any open dropdown so reopening is clean.
        if (!open) closeAll();
      });
    }

    var MOBILE_MQ = '(max-width: 719.98px)';
    function isMobile() {
      return window.matchMedia && window.matchMedia(MOBILE_MQ).matches;
    }

    var dropdowns = primaryNav.querySelectorAll('.nav-dropdown');
    if (!dropdowns.length) return;

    var openTimer = null;
    var closeTimer = null;

    function openDD(li) {
      var trigger = li.querySelector('.nav-dropdown-trigger');
      var panel = li.querySelector('.nav-dropdown-panel');
      if (!trigger || !panel) return;
      // Single-open invariant: close any other open dropdown first.
      closeAllExcept(li);
      trigger.setAttribute('aria-expanded', 'true');
      panel.hidden = false;
      li.classList.add('open');
      // Enable arrow-key navigation inside the panel.
      var items = panel.querySelectorAll('a[role="menuitem"]');
      for (var i = 0; i < items.length; i++) items[i].setAttribute('tabindex', '0');
    }

    function closeDD(li, opts) {
      var trigger = li.querySelector('.nav-dropdown-trigger');
      var panel = li.querySelector('.nav-dropdown-panel');
      if (!trigger || !panel) return;
      trigger.setAttribute('aria-expanded', 'false');
      panel.hidden = true;
      li.classList.remove('open');
      var items = panel.querySelectorAll('a[role="menuitem"]');
      for (var i = 0; i < items.length; i++) items[i].setAttribute('tabindex', '-1');
      if (opts && opts.restoreFocus) trigger.focus();
    }

    function closeAll() {
      for (var i = 0; i < dropdowns.length; i++) closeDD(dropdowns[i]);
    }

    function closeAllExcept(keep) {
      for (var i = 0; i < dropdowns.length; i++) {
        if (dropdowns[i] !== keep) closeDD(dropdowns[i]);
      }
    }

    function toggleDD(li) {
      var trigger = li.querySelector('.nav-dropdown-trigger');
      if (!trigger) return;
      if (trigger.getAttribute('aria-expanded') === 'true') closeDD(li);
      else openDD(li);
    }

    function cancelTimers() {
      if (openTimer) { clearTimeout(openTimer); openTimer = null; }
      if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
    }

    for (var i = 0; i < dropdowns.length; i++) {
      (function (li) {
        var trigger = li.querySelector('.nav-dropdown-trigger');
        var panel = li.querySelector('.nav-dropdown-panel');
        if (!trigger || !panel || trigger.dataset.wired) return;
        trigger.dataset.wired = '1';

        // Click toggles (works on both desktop and mobile).
        trigger.addEventListener('click', function (ev) {
          ev.preventDefault();
          ev.stopPropagation();
          cancelTimers();
          toggleDD(li);
        });

        // Esc closes + restores focus to trigger.
        trigger.addEventListener('keydown', function (ev) {
          if (ev.key === 'Escape') {
            ev.stopPropagation();
            closeDD(li, { restoreFocus: true });
          } else if (ev.key === 'ArrowDown' || ev.key === 'Down') {
            // Open + focus first item.
            ev.preventDefault();
            openDD(li);
            var first = panel.querySelector('a[role="menuitem"]');
            if (first) first.focus();
          }
        });

        // Hover open (desktop only) — small intent delay prevents flicker.
        li.addEventListener('mouseenter', function () {
          if (isMobile()) return;
          cancelTimers();
          openTimer = setTimeout(function () { openDD(li); }, 120);
        });
        li.addEventListener('mouseleave', function () {
          if (isMobile()) return;
          cancelTimers();
          // 200 ms grace so cursor can travel trigger → panel without snapping shut.
          closeTimer = setTimeout(function () { closeDD(li); }, 200);
        });

        // Esc anywhere in panel closes.
        panel.addEventListener('keydown', function (ev) {
          if (ev.key === 'Escape') {
            ev.stopPropagation();
            closeDD(li, { restoreFocus: true });
            return;
          }
          // Arrow-key navigation between items.
          var items = panel.querySelectorAll('a[role="menuitem"]');
          if (!items.length) return;
          var idx = -1;
          for (var k = 0; k < items.length; k++) {
            if (items[k] === document.activeElement) { idx = k; break; }
          }
          if (ev.key === 'ArrowDown' || ev.key === 'Down') {
            ev.preventDefault();
            items[(idx + 1) % items.length].focus();
          } else if (ev.key === 'ArrowUp' || ev.key === 'Up') {
            ev.preventDefault();
            items[(idx - 1 + items.length) % items.length].focus();
          } else if (ev.key === 'Home') {
            ev.preventDefault();
            items[0].focus();
          } else if (ev.key === 'End') {
            ev.preventDefault();
            items[items.length - 1].focus();
          } else if (ev.key === 'Tab') {
            // Let Tab move naturally; focusout below will close once focus leaves.
          }
        });

        // Focus leaves the dropdown (trigger + panel) → close. Use focusout +
        // relatedTarget check so internal focus moves don't close prematurely.
        li.addEventListener('focusout', function (ev) {
          var next = ev.relatedTarget;
          if (next && li.contains(next)) return; // still inside — leave open
          // Schedule close on next tick so click handlers on items can navigate first.
          setTimeout(function () {
            if (!li.contains(document.activeElement)) closeDD(li);
          }, 0);
        });
      })(dropdowns[i]);
    }

    // Outside click closes all dropdowns.
    document.addEventListener('click', function (ev) {
      var t = ev.target;
      // If click landed inside any dropdown <li>, the trigger handler above
      // owns the decision — bail.
      for (var i = 0; i < dropdowns.length; i++) {
        if (dropdowns[i].contains(t)) return;
      }
      closeAll();
    });

    // Esc on document closes whichever dropdown is open + restores focus.
    document.addEventListener('keydown', function (ev) {
      if (ev.key !== 'Escape') return;
      for (var i = 0; i < dropdowns.length; i++) {
        if (dropdowns[i].classList.contains('open')) {
          closeDD(dropdowns[i], { restoreFocus: true });
          return;
        }
      }
    });

    // Clicking a link inside the drawer closes drawer + dropdown so bfcache
    // restore doesn't leave a stale open state.
    primaryNav.addEventListener('click', function (e) {
      var a = e.target && e.target.closest ? e.target.closest('a') : null;
      if (!a) return;
      // Skip if it's the trigger (which is a <button>, not <a> — closest('a') ignores it).
      primaryNav.classList.remove('open');
      navToggle.setAttribute('aria-expanded', 'false');
      closeAll();
    });

    // Viewport crosses 720 px breakpoint — close any open dropdown so the
    // desktop fly-out vs mobile collapsible models don't collide.
    var mql = window.matchMedia ? window.matchMedia(MOBILE_MQ) : null;
    if (mql) {
      var onChange = function () { closeAll(); };
      if (mql.addEventListener) mql.addEventListener('change', onChange);
      else if (mql.addListener) mql.addListener(onChange); // Safari < 14
    }
  })();
</script>

<style>
  /* Component-scoped tweaks layered atop global.css's .header-wrap / .nav-* base.
     Mobile-first: the global stylesheet covers most layout; this block adds
     archive-specific spacing inside the brand row + the row layout. */
  .brand-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
    padding: 8px 0;
    gap: 16px;
  }

  /* CLAUDE.md §4 — sticky 64px header. The .header-wrap base lives in
     global.css; this scoped rule ensures the inner header element fills it. */
  header { width: 100%; }
</style>
